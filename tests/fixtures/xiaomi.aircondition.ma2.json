     "format": "uint8",
     "access": [
      "read",
      "write",
      "notify"
     ],
     "value-list": [
      {
       "value": 0,
       "description": "Auto"
      },
      {
       "value": 1,
       "description": "Level1"
      },
      {
       "value": 2,
       "description": "Level2"
      },
      {
       "value": 3,
       "description": "Level3"
      },
      {
       "value": 4,
       "description": "Level4"
      },
      {
       "value": 5,
       "description": "Level5"
      },
      {
       "value": 6,
       "description": "Level6"
      },
      {
       "value": 7,
       "description": "Level7"
      }
     ]
    },
    {
     "iid": 2,
     "type": "urn:miot-spec-v2:property:vertical-swing:00000018:xiaomi-ma2:1",
     "description": "Vertical Swing",
     "format": "bool",
     "access": [
      "read",
      "write",
      "notify"
     ]
    },
    {
     "iid": 3,
     "type": "urn:miot-spec-v2:property:fan-level:00000016:xiaomi-ma2:1",
