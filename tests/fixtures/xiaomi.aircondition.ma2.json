   "type": "urn:miot-spec-v2:service:device-information:00007801:xiaomi-ma2:1",
   "description": "Device Information",
   "properties": []
  },
  {
   "iid": 2,
   "type": "urn:miot-spec-v2:service:air-conditioner:0000780F:xiaomi-ma2:1",
   "description": "Air Conditioner",
   "properties": [
    {
     "iid": 1,
     "type": "urn:miot-spec-v2:property:on:00000006:xiaomi-ma2:1",
     "description": "Switch Status",
     "format": "bool",
     "access": [
      "read",
      "write",
      "notify"
     ]
    },
    {
     "iid": 2,
     "type": "urn:miot-spec-v2:property:mode:00000008:xiaomi-ma2:2",
     "description": "Mode",
     "format": "uint8",
     "access": [
      "read",
      "write",
      "notify"
     ],
     "value-list": [
      {
       "value": 2,
       "description": "Cool"
      },
      {
       "value": 3,
       "description": "Dry"
      },
      {
       "value": 4,
       "description": "Fan"
      },
      {
       "value": 5,
       "description": "Heat"
      }
     ]
    },
    {
     "iid": 3,
     "type": "urn:miot-spec-v2:property:target-temperature:00000021:xiaomi-ma2:1",
     "description": "Target Temperature",
     "format": "float",
     "access": [
      "read",
      "write",
      "notify"
     ],
     "unit": "celsius",
     "value-range": [
      16,
      31,
      0.5
     ]
    }
   ]
  },
  {
   "iid": 3,
   "type": "urn:miot-spec-v2:service:fan-control:00007809:xiaomi-ma2:1",
