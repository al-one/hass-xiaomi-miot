     "format": "uint8",
     "access": [
      "read",
      "write",
      "notify"
     ],
     "value-range": [
      1,
      101,
      1
     ]
    }
   ]
  },
  {
   "iid": 4,
   "type": "urn:miot-spec-v2:service:environment:0000780A:xiaomi-ma2:1",
